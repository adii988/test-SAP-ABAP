projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_AP_P_Travel //alias <alias_name>
{




  use create;
  use update;
  use delete;
  use action cancel_travel;

  use action checkCustomer;
  use action adjustDuration;

  use association _Item { create; with draft; }


  side effects {
    determine action checkCustomer
    executed on field CustomerId
    affects messages,
    field CustomerId;

    }



  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

  define behavior for ZC_AP_P_TravelItem
  use etag
  {
    use update;
    use delete;

    use association _Travel { with draft; }
  }