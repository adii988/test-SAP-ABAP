managed implementation in class zbp_r_ap_i_employyes unique;
strict ( 2 ); with draft;

define behavior for ZR_AP_I_EMPLOYYES //alias <alias_name>
persistent table zap_employees
draft table zap_employees_d
lock master total etag Lastchangedat
authorization master ( instance )
etag master Lastchangedat
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly, numbering : managed ) EmpUuid;
  field ( readonly : update ) Empid;
  field ( readonly ) Changedby , Lastchangedat;

  validation validatesal on save { create; field Salary; }

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zap_employees corresponding

  {
  EmpUuid  = emp_uuid;
  Empid    = empid;
  Fname    = fname;
  Lname    = lname;
  Salary   = salary;
  Currencycode = currencycode;
  Dob = dob;
  Age = age;
  Changedby = changedby;
  Lastchangedat = lastchangedat;

    }


}